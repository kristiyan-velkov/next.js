auto-install-peers = true
lockfile = true
link-workspace-packages = true
provenance = true
save-exact = true
strict-peer-dependencies = false
tag-version-prefix=""
# Hardening (safe subset of the reference .npmrc; ignore-scripts/engine-strict omitted because they break this workspace build)
registry=https://registry.npmjs.org/
strict-ssl=true
fund=false
update-notifier=false
